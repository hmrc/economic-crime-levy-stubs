# microservice specific routes

GET         /enterprise/obligation-data/:idType/:idNumber/:regimeType               uk.gov.hmrc.economiccrimelevystubs.controllers.ObligationDataController.getObligationData(idType, idNumber, regimeType)
GET         /penalty/financial-data/:idType/:idNumber/:regimeType                   uk.gov.hmrc.economiccrimelevystubs.controllers.FinancialDetailsController.getFinancialDetails(idType, idNumber, regimeType)
GET         /cross-regime/subscription/:regime/:idType/:idValue/status              uk.gov.hmrc.economiccrimelevystubs.controllers.SubscriptionStatusController.getSubscriptionStatus(regime, idType, idValue)

# Integration Framework
POST        /economic-crime-levy/subscription/:safeId                               uk.gov.hmrc.economiccrimelevystubs.controllers.IFSubscriptionController.createSubscription(safeId)
GET         /economic-crime-levy/subscription/:eclRegistrationReference             uk.gov.hmrc.economiccrimelevystubs.controllers.IFSubscriptionController.getSubscription(eclRegistrationReference)

# Hip
GET         /etmp/RESTAdaptor/economic-crime-levy/subscription/:regReference        uk.gov.hmrc.economiccrimelevystubs.controllers.HipSubscriptionController.getSubscription(regReference)
POST        /etmp/RESTAdaptor/economic-crime-levy/subscription/:safeId              uk.gov.hmrc.economiccrimelevystubs.controllers.HipSubscriptionController.createSubscription(safeId)

GET         /economic-crime-levy/return/:periodKey/:eclRegistrationReference        uk.gov.hmrc.economiccrimelevystubs.controllers.ReturnIfController.getReturn(periodKey, eclRegistrationReference)
POST        /economic-crime-levy/return/:eclRegistrationReference                   uk.gov.hmrc.economiccrimelevystubs.controllers.ReturnIfController.submitReturn(eclRegistrationReference)

GET         /enrolments/cleanup-references                                          uk.gov.hmrc.economiccrimelevystubs.controllers.EnrolmentCleanUpController.referencesForCleanup()

GET         /echo                                                                   uk.gov.hmrc.economiccrimelevystubs.controllers.EchoController.echo()

POST        /dms-submission/submit                                                  uk.gov.hmrc.economiccrimelevystubs.controllers.DmsSubmissionController.submit()

# HIP routes
POST        /etmp/RESTAdapter/cross-regime/taxpayer/financial-data/query            uk.gov.hmrc.economiccrimelevystubs.controllers.FinancialDetailsHipController.getFinancialDetailsHip

GET         /etmp/RESTAdapter/economic-crime-levy/return/:periodKey/:eclRegistrationReference        uk.gov.hmrc.economiccrimelevystubs.controllers.ReturnHipController.getReturn(periodKey, eclRegistrationReference)
POST        /etmp/RESTAdapter/economic-crime-levy/return/:eclRegistrationReference                   uk.gov.hmrc.economiccrimelevystubs.controllers.ReturnHipController.submitReturn(eclRegistrationReference)